{
  "name": "mrl-personel-takip",
  "version": "2.0.0",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "build:icons": "node scripts/build-icons.mjs",
    "sync": "npx cap sync android",
    "android": "npx cap open android",
    "build:win": "npm run build:icons && node scripts/copy-pdf.mjs && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "pdfmake": "^0.2.20"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.3"
  },
  "build": {
    "appId": "com.mrl.mesailerim.desktop",
    "productName": "Mesailerim",
    "directories": { "output": "dist" },
    "files": ["www/**/*", "electron-main.js"],
    "win": { "target": ["portable"], "artifactName": "Mesailerim.exe", "icon": "resources/icon.png" }
  }
}
