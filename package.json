{
  "name": "mrl-hakedis",
  "version": "1.0.0",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "copy:assets": "node scripts/copy-assets.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:win": "npm run build:icons && npm run copy:assets && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3",
    "pdfmake": "0.2.20",
    "exceljs": "3.10.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "7.4.3",
    "electron": "37.2.6",
    "electron-builder": "26.0.12",
    "sharp": "0.34.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "build": {
    "appId": "com.mrl.hakedis",
    "productName": "MRL Hakediş",
    "directories": {"output": "dist"},
    "files": ["www/**/*", "electron-main.js"],
    "win": {"target": ["portable"], "artifactName": "MRL-Hakedis.exe", "icon": "resources/icon.png"}
  }
}
